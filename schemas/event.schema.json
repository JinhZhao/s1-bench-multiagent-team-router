{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S1 Event Log Entry",
  "description": "One event in the JSONL trace. Each run produces an ordered list of these.",
  "type": "object",
  "required": ["event_id", "seq", "run_id", "task_id", "event_type", "timestamp"],
  "properties": {
    "event_id": {"type": "string"},
    "seq": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string"},
    "task_id": {"type": "string"},
    "benchmark": {"type": "string"},
    "mode": {"type": "string"},
    "event_type": {
      "type": "string",
      "enum": [
        "run.started", "run.completed", "run.failed", "run.cancelled",
        "route.selected",
        "team.started", "team.completed",
        "handoff.requested", "handoff.accepted", "handoff.rejected",
        "tool.call.started", "tool.call.completed",
        "model.usage",
        "grader.completed",
        "error.raised", "recovery.attempted", "recovery.completed",
        "checkpoint.saved",
        "stream.opened", "stream.closed"
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "monotonic_ns": {"type": "integer"},
    "from_team": {"type": "string"},
    "to_team": {"type": "string"},
    "from_agent": {"type": "string"},
    "to_agent": {"type": "string"},
    "handoff_id": {"type": "string"},
    "idempotency_key": {"type": "string"},
    "status": {"type": "string"},
    "attempt": {"type": "integer", "minimum": 1},
    "input_ref": {"type": "string"},
    "output_ref": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "tool_name": {"type": "string"},
    "tool_call_id": {"type": "string"},
    "error_code": {"type": "string"},
    "recovery_strategy": {"type": "string"},
    "provider_request_id": {"type": "string"},
    "model_id": {"type": "string"},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "reasoning_tokens": {"type": "integer", "minimum": 0},
    "cached_tokens": {"type": "integer", "minimum": 0},
    "usage_source": {"type": "string"},
    "elapsed_ms": {"type": "integer", "minimum": 0},
    "retry_count": {"type": "integer", "minimum": 0},
    "cost_usd": {"type": "number", "minimum": 0},
    "transport": {"type": "string"},
    "stream_id": {"type": "string"},
    "sse_event_id": {"type": "string"},
    "sse_seq": {"type": "integer", "minimum": 0}
  }
}
